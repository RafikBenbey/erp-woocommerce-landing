backend:
  name: git-gateway
  branch: main

media_folder: "public/images"
public_folder: "/images"

collections:
  - name: "landing"
    label: "Landing Page"
    files:
      - file: "content.json"
        label: "Contenu de la page"
        name: "content"
        fields:
          - {label: "Badge Hero", name: "hero_badge", widget: "string"}
          - {label: "Titre Principal", name: "hero_title", widget: "string"}
          - {label: "Description", name: "hero_description", widget: "text"}
          - {label: "Image Principale", name: "hero_image", widget: "image", required: false}
          - {label: "Texte Bouton", name: "cta_button", widget: "string"}
